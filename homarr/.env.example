# Copy this file to .env and fill in your value.
# Never commit .env to git — add it to .gitignore.

# Required by Homarr for session encryption.
# Must be exactly 64 hex characters.
# Generate with: openssl rand -hex 32
# Homarr's own suggestion: f33d2432feedc2fa26f7edeb3468326da0ef33983ce435aeeeaa541b5076ba7d
SECRET_ENCRYPTION_KEY=change-me-to-64-char-hex-string
