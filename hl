#!/usr/bin/env bash
# hl — Pi homelab management script
#
# Place this script at the level of the compose file you want to manage:
#   ~/repo/hl          → uses ~/repo/compose.yaml   (all stacks)
#   ~/repo/homelab/hl  → uses ~/repo/homelab/compose-global.yaml (homelab only)
#
# Usage: hl [options] <command> [service]
#
# Options:
#   -f <file>   Override the compose file path
#
# Commands:
#   up      [service]   Start all services (or a single one)
#   down    [service]   Stop all services (or a single one)
#   restart [service]   Stop → start with orphan cleanup
#   update  [service]   Pull latest images and restart
#   logs    [service]   Follow logs (Ctrl-C to stop)
#   list                List all services across all stacks
#   status              Show running container states
#   exec <svc> [cmd]    Open a shell in a container (default: sh)
#
# Examples:
#   hl up
#   hl restart homarr
#   hl update paperless
#   hl logs traefik
#   hl exec paperless bash
#   hl -f ~/repo/homelab/compose-global.yaml status

set -euo pipefail

# ── Resolve compose file ──────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Candidates in priority order
_find_compose() {
  local candidates=(
    "$SCRIPT_DIR/compose.yaml"
    "$SCRIPT_DIR/compose-global.yaml"
    "$SCRIPT_DIR/docker-compose.yml"
    "$SCRIPT_DIR/docker-compose.yaml"
  )
  for f in "${candidates[@]}"; do
    if [[ -f "$f" ]]; then echo "$f"; return; fi
  done
  echo ""
}

COMPOSE_FILE="$(_find_compose)"

# ── Colours ───────────────────────────────────────────────────────────────────
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
DIM='\033[2m'
RESET='\033[0m'

info()    { echo -e "${CYAN}▶ $*${RESET}"; }
success() { echo -e "${GREEN}✔ $*${RESET}"; }
warn()    { echo -e "${YELLOW}⚠ $*${RESET}"; }
die()     { echo -e "${RED}✘ $*${RESET}" >&2; exit 1; }

usage() {
  echo -e "${BOLD}hl — Homelab manager${RESET}"
  echo ""
  echo -e "${BOLD}Usage:${RESET} $(basename "$0") [-f compose-file] <command> [service]"
  echo ""
  echo -e "${BOLD}Options:${RESET}"
  echo "  -f <file>   Override the compose file (default: auto-detected)"
  echo ""
  echo -e "${BOLD}Commands:${RESET}"
  printf "  %-22s %s\n" "up [service]"      "Start all services or a single one"
  printf "  %-22s %s\n" "down [service]"    "Stop all services or a single one"
  printf "  %-22s %s\n" "restart [service]" "Stop → start with orphan cleanup"
  printf "  %-22s %s\n" "update [service]"  "Pull latest images and restart"
  printf "  %-22s %s\n" "logs [service]"    "Follow logs (Ctrl-C to stop)"
  printf "  %-22s %s\n" "list"              "List all services across all stacks"
  printf "  %-22s %s\n" "status"            "Show running container states"
  printf "  %-22s %s\n" "exec <svc> [cmd]"  "Open a shell in a container"
  echo ""
  echo -e "${DIM}Active compose file: ${COMPOSE_FILE:-"none found"}${RESET}"
  exit 0
}

# ── Parse options ─────────────────────────────────────────────────────────────
while getopts ":f:h" opt; do
  case $opt in
    f) COMPOSE_FILE="$OPTARG" ;;
    h) usage ;;
    \?) die "Unknown option: -$OPTARG" ;;
  esac
done
shift $((OPTIND - 1))

[[ -z "$COMPOSE_FILE" ]] && die "No compose file found in ${SCRIPT_DIR}.\nRun with -f <path> to specify one."
[[ ! -f "$COMPOSE_FILE" ]] && die "Compose file not found: ${COMPOSE_FILE}"

# ── Compose wrapper ───────────────────────────────────────────────────────────
dc() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

# ── Commands ──────────────────────────────────────────────────────────────────
cmd_up() {
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    info "Starting ${svc}..."
    dc up -d "$svc"
  else
    info "Starting all services..."
    dc up -d
  fi
  success "Done."
}

cmd_down() {
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    info "Stopping ${svc}..."
    dc stop "$svc" && dc rm -f "$svc"
  else
    info "Stopping all services..."
    dc down --remove-orphans
  fi
  success "Done."
}

cmd_restart() {
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    info "Restarting ${svc}..."
    dc stop "$svc" && dc rm -f "$svc"
    dc up -d "$svc"
  else
    info "Restarting all services..."
    dc down --remove-orphans
    dc up -d
  fi
  success "Done."
}

cmd_update() {
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    info "Pulling latest image for ${svc}..."
    dc pull "$svc"
    info "Restarting ${svc}..."
    dc stop "$svc" && dc rm -f "$svc"
    dc up -d "$svc"
  else
    info "Pulling all latest images..."
    dc pull
    info "Restarting all services..."
    dc up -d
  fi
  success "Update complete."
}

cmd_logs() {
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    dc logs -f --tail=100 "$svc"
  else
    dc logs -f --tail=50
  fi
}

cmd_list() {
  echo -e "${BOLD}Services in ${COMPOSE_FILE}:${RESET}"
  echo ""
  # docker compose config --services resolves all includes and prints one service per line
  dc config --services 2>/dev/null | sort | while read -r svc; do
    # Check if it's running
    state="$(dc ps --status running --quiet "$svc" 2>/dev/null)"
    if [[ -n "$state" ]]; then
      echo -e "  ${GREEN}●${RESET} ${svc}"
    else
      echo -e "  ${DIM}○${RESET} ${DIM}${svc}${RESET}"
    fi
  done
  echo ""
  echo -e "${DIM}● running  ○ stopped${RESET}"
}

cmd_status() {
  dc ps
}

cmd_exec() {
  local svc="${1:-}"
  local shell_cmd="${2:-sh}"
  [[ -z "$svc" ]] && die "exec requires a service name.\n  Usage: $(basename "$0") exec <service> [command]"
  info "Opening ${shell_cmd} in ${svc}..."
  dc exec "$svc" "$shell_cmd"
}

# ── Entry point ───────────────────────────────────────────────────────────────
[[ $# -eq 0 ]] && usage

COMMAND="${1:-}"
shift

case "$COMMAND" in
  up)           cmd_up "$@" ;;
  down)         cmd_down "$@" ;;
  restart)      cmd_restart "$@" ;;
  update)       cmd_update "$@" ;;
  logs)         cmd_logs "$@" ;;
  list)         cmd_list ;;
  status|ps)    cmd_status ;;
  exec)         cmd_exec "$@" ;;
  help|--help|-h) usage ;;
  *) die "Unknown command: ${COMMAND}\nRun '$(basename "$0") help' for usage." ;;
esac
