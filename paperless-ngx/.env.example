# Copy this file to .env and fill in your values.
# Never commit .env to git — add it to .gitignore.

# Django secret key — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PAPERLESS_SECRET_KEY=change-me-to-a-long-random-string

# Admin account created on first startup
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me

# Timezone — adjust to your location
PAPERLESS_TIME_ZONE=Asia/Kolkata

# OCR language(s) — comma-separated ISO 639-2 codes
# eng for English, hin for Hindi, etc.
PAPERLESS_OCR_LANGUAGE=eng
